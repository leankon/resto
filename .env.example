# La app se conecta con un rol sin privilegios especiales. Es deliberado: el
# superusuario ignora las políticas de RLS y el aislamiento entre locales
# dejaría de existir sin que nadie se entere.
DATABASE_URL=postgres://resto_app:dev@localhost:5433/resto

# Solo para migraciones y para el panel de super-admin.
DATABASE_URL_ADMIN=postgres://postgres@localhost:5433/resto
